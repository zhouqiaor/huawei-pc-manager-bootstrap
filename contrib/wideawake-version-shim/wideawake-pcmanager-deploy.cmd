@echo off
setlocal EnableExtensions
REM wideawake-pcmanager-deploy.cmd  (self-extracting, single file)
REM 1) elevate to admin  2) extract 3 components to %TEMP%\wideawake  3) run deploy
net session >nul 2>&1
if %%errorLevel%% neq 0 (
  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)

powershell -NoProfile -ExecutionPolicy Bypass -Command "
$cmd = '%~f0';
$text = [System.IO.File]::ReadAllText($cmd);
$work = Join-Path $env:TEMP 'wideawake';
New-Item -ItemType Directory -Force -Path $work | Out-Null;
function Extract($name,$file){
  $m = [regex]::Match($text, '(?s)===START ' + [regex]::Escape($name) + '===(.*?)===END ' + [regex]::Escape($name) + '===');
  if(-not $m.Success){ Write-Host ('missing ' + $name); exit 1; }
  $b = [Convert]::FromBase64String($m.Groups[1].Value -replace '\s','');
  [System.IO.File]::WriteAllBytes((Join-Path $work $file), $b);
  Write-Host ('extracted ' + $file + ' (' + $b.Length + ' bytes)');
}
Extract 'SHIM' 'version.dll';
Extract 'GATE' 'MBAInstallPreGate.exe';
Extract 'SCRIPT' 'deploy_payload.ps1';
& (Join-Path $work 'deploy_payload.ps1');
pause
"
goto :eof

